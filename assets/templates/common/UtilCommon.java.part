    // ----- text & numbers -------------------------------------------------

    public static String fmt(double d) {
        if (Double.isNaN(d) || Double.isInfinite(d)) return String.valueOf(d);
        if (d == Math.rint(d) && Math.abs(d) < 1e15) return Long.toString((long) d);
        return String.valueOf(Math.round(d * 100.0) / 100.0);
    }

    public static double num(String s) {
        if (s == null) return 0;
        try {
            return Double.parseDouble(s.trim().replace(',', '.'));
        } catch (NumberFormatException e) {
            return 0;
        }
    }

    public static boolean isNum(String s) {
        if (s == null) return false;
        try {
            Double.parseDouble(s.trim().replace(',', '.'));
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    public static String format(String f, String a, String b, String c, String d) {
        return f.replace("{0}", a).replace("{1}", b).replace("{2}", c).replace("{3}", d);
    }

    public static boolean textEquals(String a, String b, boolean ignoreCase) {
        if (a == null || b == null) return a == b;
        return ignoreCase ? a.trim().equalsIgnoreCase(b.trim()) : a.equals(b);
    }

    public static double math(double a, String op, double b) {
        switch (op) {
            case "+": return a + b;
            case "-": return a - b;
            case "*": return a * b;
            case "/": return b == 0 ? 0 : a / b;
            case "%": return b == 0 ? 0 : a % b;
            case "pow": return Math.pow(a, b);
            case "min": return Math.min(a, b);
            case "max": return Math.max(a, b);
            default: return 0;
        }
    }

    public static double random(double min, double max) {
        long lo = Math.round(Math.min(min, max));
        long hi = Math.round(Math.max(min, max));
        return java.util.concurrent.ThreadLocalRandom.current().nextLong(lo, hi + 1);
    }

    public static String arg(String[] args, int i) {
        return args != null && args.length > i ? args[i] : "";
    }

    public static java.util.List<String> tab(String[] options, String prefix) {
        String p = prefix == null ? "" : prefix.toLowerCase(java.util.Locale.ROOT);
        java.util.List<String> out = new java.util.ArrayList<>();
        for (String o : options) {
            if (o.toLowerCase(java.util.Locale.ROOT).startsWith(p)) out.add(o);
        }
        return out;
    }

    /** Arguments from index i to the end, joined with spaces. */
    public static String rest(String[] args, int i) {
        if (args == null || args.length <= i) return "";
        return String.join(" ", java.util.Arrays.copyOfRange(args, i, args.length));
    }

    public static boolean isInt(String s) {
        return isNum(s) && num(s) == Math.floor(num(s));
    }

    public static boolean isBool(String s) {
        String v = s == null ? "" : s.trim().toLowerCase(java.util.Locale.ROOT);
        return java.util.List.of("ja", "nein", "yes", "no", "true", "false", "an", "aus", "on", "off", "1", "0").contains(v);
    }

    public static boolean bool(String s) {
        String v = s == null ? "" : s.trim().toLowerCase(java.util.Locale.ROOT);
        return java.util.List.of("ja", "yes", "true", "an", "on", "1").contains(v);
    }

    public static boolean oneOf(String s, String[] options) {
        for (String o : options) {
            if (o.equalsIgnoreCase(s)) return true;
        }
        return false;
    }

    private static final java.util.Map<String, Long> COOLDOWNS = new java.util.concurrent.ConcurrentHashMap<>();

    /** 0 if the cooldown is over (and starts it again), otherwise the seconds left. */
    public static double cooldown(String key, double seconds) {
        long now = System.currentTimeMillis();
        Long until = COOLDOWNS.get(key);
        if (until != null && until > now) {
            return Math.ceil((until - now) / 100.0) / 10.0;
        }
        COOLDOWNS.put(key, now + (long) (seconds * 1000));
        return 0;
    }

    /** Parses one menu line "slot: item | name | lore". Returns null if invalid. */
    public static String[] menuLine(String line) {
        int colon = line.indexOf(':');
        if (colon < 0) return null;
        String slot = line.substring(0, colon).trim();
        if (!isInt(slot)) return null;
        String[] parts = line.substring(colon + 1).split("\\|", 3);
        return new String[] {
            slot,
            parts[0].trim(),
            parts.length > 1 ? parts[1].trim() : "",
            parts.length > 2 ? parts[2].trim() : ""
        };
    }
