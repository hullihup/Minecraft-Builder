    // ----- text & numbers -------------------------------------------------

    public static String fmt(double d) {
        if (Double.isNaN(d) || Double.isInfinite(d)) return String.valueOf(d);
        if (d == Math.rint(d) && Math.abs(d) < 1e15) return Long.toString((long) d);
        return String.valueOf(Math.round(d * 100.0) / 100.0);
    }

    public static double num(String s) {
        if (s == null) return 0;
        try {
            return Double.parseDouble(s.trim().replace(',', '.'));
        } catch (NumberFormatException e) {
            return 0;
        }
    }

    public static boolean isNum(String s) {
        if (s == null) return false;
        try {
            Double.parseDouble(s.trim().replace(',', '.'));
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }

    public static String format(String f, String a, String b, String c, String d) {
        return f.replace("{0}", a).replace("{1}", b).replace("{2}", c).replace("{3}", d);
    }

    public static boolean textEquals(String a, String b, boolean ignoreCase) {
        if (a == null || b == null) return a == b;
        return ignoreCase ? a.trim().equalsIgnoreCase(b.trim()) : a.equals(b);
    }

    public static double math(double a, String op, double b) {
        switch (op) {
            case "+": return a + b;
            case "-": return a - b;
            case "*": return a * b;
            case "/": return b == 0 ? 0 : a / b;
            case "%": return b == 0 ? 0 : a % b;
            case "pow": return Math.pow(a, b);
            case "min": return Math.min(a, b);
            case "max": return Math.max(a, b);
            default: return 0;
        }
    }

    public static double random(double min, double max) {
        long lo = Math.round(Math.min(min, max));
        long hi = Math.round(Math.max(min, max));
        return java.util.concurrent.ThreadLocalRandom.current().nextLong(lo, hi + 1);
    }

    public static String arg(String[] args, int i) {
        return args != null && args.length > i ? args[i] : "";
    }

    public static java.util.List<String> tab(String[] options, String prefix) {
        String p = prefix == null ? "" : prefix.toLowerCase(java.util.Locale.ROOT);
        java.util.List<String> out = new java.util.ArrayList<>();
        for (String o : options) {
            if (o.toLowerCase(java.util.Locale.ROOT).startsWith(p)) out.add(o);
        }
        return out;
    }

    /** Arguments from index i to the end, joined with spaces. */
    public static String rest(String[] args, int i) {
        if (args == null || args.length <= i) return "";
        return String.join(" ", java.util.Arrays.copyOfRange(args, i, args.length));
    }

    public static boolean isInt(String s) {
        return isNum(s) && num(s) == Math.floor(num(s));
    }

    public static boolean isBool(String s) {
        String v = s == null ? "" : s.trim().toLowerCase(java.util.Locale.ROOT);
        return java.util.List.of("ja", "nein", "yes", "no", "true", "false", "an", "aus", "on", "off", "1", "0").contains(v);
    }

    public static boolean bool(String s) {
        String v = s == null ? "" : s.trim().toLowerCase(java.util.Locale.ROOT);
        return java.util.List.of("ja", "yes", "true", "an", "on", "1").contains(v);
    }

    public static boolean oneOf(String s, String[] options) {
        for (String o : options) {
            if (o.equalsIgnoreCase(s)) return true;
        }
        return false;
    }

    private static final java.util.Map<String, Long> COOLDOWNS = new java.util.concurrent.ConcurrentHashMap<>();

    /** 0 if the cooldown is over (and starts it again), otherwise the seconds left. */
    public static double cooldown(String key, double seconds) {
        long now = System.currentTimeMillis();
        Long until = COOLDOWNS.get(key);
        if (until != null && until > now) {
            return Math.ceil((until - now) / 100.0) / 10.0;
        }
        COOLDOWNS.put(key, now + (long) (seconds * 1000));
        return 0;
    }

    /**
     * Parses one menu line. New format (written by the menu editor), separated by tabs:
     * slot, item, name, lore, amount, model, flags, id, click action, action value.
     * Old format: "slot: item | name | lore". Returns null if invalid, otherwise always 10 entries.
     */
    public static String[] menuLine(String line) {
        String[] out = { "", "", "", "", "1", "", "", "", "", "" };
        if (line.indexOf('\t') >= 0) {
            String[] parts = line.split("\t", -1);
            for (int i = 0; i < parts.length && i < out.length; i++) {
                if (!parts[i].trim().isEmpty() || i < 4) out[i] = parts[i].trim();
            }
        } else {
            int colon = line.indexOf(':');
            if (colon < 0) return null;
            out[0] = line.substring(0, colon).trim();
            String[] parts = line.substring(colon + 1).split("\\|", 3);
            for (int i = 0; i < parts.length; i++) out[i + 1] = parts[i].trim();
        }
        if (!isInt(out[0]) || out[1].isEmpty()) return null;
        return out;
    }

    /** Is the point inside the box between two corners (any order)? */
    public static boolean between(double v, double a, double b) {
        return v >= Math.min(a, b) && v <= Math.max(a, b);
    }

    // ----- session variables & lists ---------------------------------------------

    /** Values that live until the server stops ("Variable" blocks). */
    public static final java.util.Map<String, String> VARS = new java.util.concurrent.ConcurrentHashMap<>();
    private static final java.util.Map<String, java.util.List<String>> LISTS = new java.util.concurrent.ConcurrentHashMap<>();

    public static void varSet(String key, String value) {
        if (value == null || value.isEmpty()) VARS.remove(key); else VARS.put(key, value);
    }

    public static String varGet(String key) {
        return VARS.getOrDefault(key, "");
    }

    public static double varAdd(String key, double by) {
        double n = num(varGet(key)) + by;
        VARS.put(key, fmt(n));
        return n;
    }

    private static java.util.List<String> list(String key) {
        return LISTS.computeIfAbsent(key, k -> new java.util.concurrent.CopyOnWriteArrayList<>());
    }

    public static void listAdd(String key, String value, boolean unique) {
        if (value == null) return;
        if (!unique || !list(key).contains(value)) list(key).add(value);
    }

    public static void listRemove(String key, String value) {
        list(key).remove(value);
    }

    public static void listClear(String key) {
        LISTS.remove(key);
    }

    public static boolean listHas(String key, String value) {
        return list(key).contains(value);
    }

    public static double listSize(String key) {
        return list(key).size();
    }

    /** Entry number `index` (1 = first), "" if there is none. */
    public static String listGet(String key, double index) {
        int i = (int) index - 1;
        java.util.List<String> l = list(key);
        return i >= 0 && i < l.size() ? l.get(i) : "";
    }

    public static String listJoin(String key, String separator) {
        return String.join(separator, list(key));
    }

    public static java.util.List<String> listCopy(String key) {
        return new java.util.ArrayList<>(list(key));
    }

    // ----- own blocks ("Function") ---------------------------------------------------

    /** Duration like "29d 17h 34m 51s". */
    public static String duration(long millis) {
        if (millis < 0) return "\u221e";
        long s = millis / 1000;
        long d = s / 86400, h = s % 86400 / 3600, m = s % 3600 / 60;
        StringBuilder sb = new StringBuilder();
        if (d > 0) sb.append(d).append("d ");
        if (d > 0 || h > 0) sb.append(h).append("h ");
        if (d > 0 || h > 0 || m > 0) sb.append(m).append("m ");
        return sb.append(s % 60).append("s").toString();
    }

